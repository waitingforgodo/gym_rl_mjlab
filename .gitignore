*.pyc

# 本机账号配置、凭据与开发工具状态。
/.aws/
/.agents/
/.codex/
/.ssh/
.env
.env.*
!.env.example
.venv/
venv/

# gym_rl 作为普通资料目录纳入；内部 Git 历史备份保存在 .cache/。
/gym_rl/**/.git/
*:Zone.Identifier

# 训练模型、推理模型和训练曲线不纳入源码仓库。
*.pt
*.pth
*.onnx
*.ckpt
*.jit
*.safetensors
events.out.tfevents.*

# gym_rl 只上传源码、文本配置、文档和许可证。

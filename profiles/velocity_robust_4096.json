    "actor.obs_normalization": true,
    "critic.obs_normalization": true,
    "actor.distribution_cfg.init_std": 1.0,
    "actor.distribution_cfg.std_type": "log",
    "num_steps_per_env": 24,
    "algorithm.optimizer": "adam",
    "algorithm.value_loss_coef": 1.0,
    "algorithm.use_clipped_value_loss": true,
    "algorithm.clip_param": 0.2,
    "algorithm.num_learning_epochs": 5,
    "algorithm.num_mini_batches": 4,
    "algorithm.learning_rate": 0.001,
    "algorithm.schedule": "adaptive",
    "algorithm.gamma": 0.99,
    "algorithm.lam": 0.95,
    "algorithm.desired_kl": 0.01,
    "algorithm.max_grad_norm": 1.0,
    "algorithm.normalize_advantage_per_mini_batch": false,
    "algorithm.entropy_coef": 0.008,
    "save_interval": 100
  },
  "source": "本地 gym_rl + Unitree/mjlab 公开配置；详见 docs/训练配置优化依据与对照实验.md",
  "_notes": {
